SUPABASE_URL=
SUPABASE_KEY=
GROQ_API_KEY=

# Supabase Secret 키 — 절대 커밋 금지. 노출 시 RLS 우회로 전체 DB 접근 가능.
# 값은 Supabase 대시보드 > Settings > API에서 확인하거나 팀 채널로 전달받아 로컬 .env에 직접 추가할 것. 이 예시 파일에는 절대로 값을 적지 말 것.
SUPABASE_SECRET_KEY=

# 공공데이터포털 메뉴젠 일반 인증키 (scripts/fetch_menuzen.py 실행 시에만 필요)
MENUZEN_API_KEY=


# 선택 (기본값 있음) — Groq 모델은 자주 지원 종료되므로 코드 대신 여기서 교체
GROQ_VISION_MODEL=qwen/qwen3.6-27b
GROQ_TEXT_MODEL=openai/gpt-oss-120b
GROQ_STT_MODEL=whisper-large-v3-turbo

# 콤마 구분, Vercel 배포 주소 추가
CORS_ORIGINS=http://localhost:5173
